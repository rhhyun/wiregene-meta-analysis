# Copy this file to .env on Synology before running docker compose.
APP_SOURCE_DIR=/volume1/docker/wiregene-meta-analysis
HOST_PORT=3001
CONTAINER_NAME=wiregene-meta

APP_BASE_URL=https://meta.wiregene.com
WIREGENE_APP_MODE=meta

APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
APP_BASIC_AUTH_USERS=
WIREGENE_ADMIN_EMAILS=

REPORT_STORAGE_BACKEND=local-json
REPORT_STORAGE_LOCAL_PATH=.data/meta/research-briefing-storage.json
GRANT_STORAGE_BACKEND=

NCBI_EMAIL=your-email@example.com
NCBI_TOOL=wiregene-meta-analysis
NCBI_API_KEY=
SCOPUS_API_KEY=
WEB_OF_SCIENCE_API_KEY=
EMBASE_API_KEY=
COCHRANE_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
META_AI_SETTINGS_STORAGE_PATH=.data/meta/meta-ai-settings.json
META_AI_SETTINGS_SECRET=
