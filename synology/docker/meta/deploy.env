# Wiregene Synology deployment site boundary.
# The common engine owns locking, timeout, Compose, verification, and rollback.
DEPLOY_SITE_NAME="${DEPLOY_SITE_NAME:-wiregene-meta}"
DEPLOY_SERVICE="${DEPLOY_SERVICE:-meta}"
DEPLOY_APP_DIR="${DEPLOY_APP_DIR:-/volume1/docker/wiregene-meta-analysis}"
DEPLOY_RUNTIME_DIR="${DEPLOY_RUNTIME_DIR:-/volume1/docker/meta}"
DEPLOY_COMPOSE_FILE="${DEPLOY_COMPOSE_FILE:-/volume1/docker/meta/docker-compose.yml}"
DEPLOY_ENV_FILE="${DEPLOY_ENV_FILE:-/volume1/docker/meta/.env}"
DEPLOY_CONTAINER_NAME="${DEPLOY_CONTAINER_NAME:-wiregene-meta}"
DEPLOY_IMAGE_ENV_KEY="${DEPLOY_IMAGE_ENV_KEY:-META_IMAGE}"
DEPLOY_IMAGE_REPOSITORY="${DEPLOY_IMAGE_REPOSITORY:-ghcr.io/rhhyun/wiregene-meta-analysis}"
DEPLOY_IMAGE="${DEPLOY_IMAGE:-ghcr.io/rhhyun/wiregene-meta-analysis:main}"
# Local-only safety tag. The engine never pulls this rollback reference.
DEPLOY_ROLLBACK_IMAGE="${DEPLOY_ROLLBACK_IMAGE:-wiregene-meta-analysis:nas-rollback}"
DEPLOY_PORT_ENV_KEY="${DEPLOY_PORT_ENV_KEY:-HOST_PORT}"
DEPLOY_HOST_PORT="${DEPLOY_HOST_PORT:-3001}"
DEPLOY_HEALTH_PATH="${DEPLOY_HEALTH_PATH:-/api/health}"
DEPLOY_HEALTH_URL="${DEPLOY_HEALTH_URL:-}"
DEPLOY_TIMEOUT_SECONDS="${DEPLOY_TIMEOUT_SECONDS:-600}"
DEPLOY_TIMEOUT_GRACE_SECONDS="${DEPLOY_TIMEOUT_GRACE_SECONDS:-20}"
DEPLOY_VERIFY_SECONDS="${DEPLOY_VERIFY_SECONDS:-180}"
DEPLOY_LOG_MAX_BYTES="${DEPLOY_LOG_MAX_BYTES:-10485760}"
DEPLOY_LOG_FILES="${DEPLOY_LOG_FILES:-3}"
